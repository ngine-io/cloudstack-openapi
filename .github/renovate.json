{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitTypeAll(deps)"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "description": "Batch the development tools into one pull request.",
      "matchDepTypes": ["dependency-groups"],
      "groupName": "dev tools"
    },
    {
      "description": "Auto-merge action patch and minor updates once CI is green.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
